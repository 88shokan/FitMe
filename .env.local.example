# Virtual try-on model. Get a key at https://fal.ai/dashboard/keys
FAL_KEY=

# Optional: speed/quality tradeoff — performance | balanced | quality
# Use "performance" while iterating, "quality" for the demo build.
FAL_TRYON_MODE=balanced

# Optional: enables the Claude-written size rationale.
# Without it, FitMe falls back to the deterministic rule-based recommendation.
ANTHROPIC_API_KEY=
